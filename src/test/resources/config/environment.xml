<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <BrowserName>${PB_BROWSER}</BrowserName>
    <URL>${PB_URL}</URL>
    <Users>
        <User>
            <Role>Operator User</Role>
            <Username>${PB_OPERATOR_USERNAME}</Username>
            <Password>${PB_OPERATOR_PASSWORD}</Password>
        </User>
        <User>
            <Role>Guest User</Role>
            <Username>${PB_GUEST_USERNAME}</Username>
            <Password>${PB_GUEST_PASSWORD}</Password>
        </User>
        <User>
            <Role>Admin User</Role>
            <Username>${PB_ADMIN_USERNAME}</Username>
            <Password>${PB_ADMIN_PASSWORD}</Password>
        </User>
        <User>
            <Role>Invalid User</Role>
            <Username>${PB_INVALID_USERNAME}</Username>
            <Password>${PB_INVALID_PASSWORD}</Password>
        </User>
    </Users>
</Configuration>
